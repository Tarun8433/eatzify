{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Eatzify (debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define-from-file=dart_defines.json"
      ]
    },
    {
      "name": "Eatzify (debug, pinned vmservice port)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define-from-file=dart_defines.json",
        "--host-vmservice-port=8181",
        "--disable-dds"
      ]
    },
    {
      "name": "Eatzify (profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "args": [
        "--dart-define-from-file=dart_defines.json"
      ]
    },
    {
      "name": "Eatzify (release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release",
      "args": [
        "--dart-define-from-file=dart_defines.json"
      ]
    }
  ]
}
