    <string name="widget_name_small">Calories</string>
    <string name="widget_name_medium">Today</string>
    <string name="widget_name_large">Today in full</string>
    <string name="widget_description_small">Today\'s calories against your plan, with steps and calories burned.</string>
    <string name="widget_description">Today\'s calories, water, steps and calories burned. Add a glass without opening the app.</string>
    <string name="widget_description_large">Everything for today — calories, water against its target, steps and calories burned — with a glass and a meal a tap away.</string>

    <string name="widget_calories_today">calories today</string>
    <string name="widget_of_calories">of %1$s calories</string>
    <string name="widget_of_kcal">of %1$s kcal</string>
    <string name="widget_ml_today">ml today</string>
    <string name="widget_of_ml">of %1$s ml</string>
    <string name="widget_steps_today">steps today</string>
    <string name="widget_kcal_active">kcal while active</string>
    <string name="widget_search_food">Search a food</string>

    <string name="widget_water">Water</string>
    <string name="widget_steps">Steps</string>
    <string name="widget_burned">Burned</string>
    <string name="widget_meal">Meal</string>
