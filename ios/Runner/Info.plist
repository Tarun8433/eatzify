<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Eatzify</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Eatzify</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Needed so a debug build can reach the dev server at <machine>.local (D-93).
	     Do NOT add NSBonjourServices alongside it: that key is an ALLOWLIST, and declaring one
	     restricted the app to the listed types only. Flutter's own VM service is advertised over
	     _dartobservatory._tcp, so listing just _http._tcp stopped `flutter run` from ever finding
	     the app on a physical device — "The Dart VM Service was not discovered after 60 seconds"
	     (D-94). Connecting OUT to a .local host needs this description, not a browse allowlist. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Eatzify connects to a development server on your local network. This is only used when running a debug build.</string>
	<!-- CMPedometer (D-99). Chosen over HealthKit: it answers "steps between two instants"
	     directly, needs no HealthKit entitlement, and draws less App Review scrutiny. No
	     UIBackgroundModes entry accompanies it — the counting happens in hardware and the app only
	     ever reads on the foreground, so a background mode would be unjustified. -->
	<key>NSMotionUsageDescription</key>
	<string>Eatzify reads your step count so your daily activity shows up alongside your plan. You can turn this off at any time and enter steps yourself instead.</string>
	<key>NSCameraUsageDescription</key>
	<string>Eatzify uses the camera to scan a food barcode, and to take a profile photo if you choose to add one.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Eatzify reads your step count so your daily activity is reflected in your plan. You can turn this off at any time and enter steps yourself instead.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Eatzify needs access to your photos so you can add a profile photo. Photos are private to you and are never shown to other users.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
