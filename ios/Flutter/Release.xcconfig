#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// D-238: Xcode 26 precompiles the google_mobile_ads module for THIS target, and that plugin
// imports the ads SDK's private GoogleMobileAds_Beta.h, outside its module map. Without this the
// app does not build. Remove when google_mobile_ads stops importing the private header.
CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = YES
