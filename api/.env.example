# Eatzify API — copy to .env and fill in.
#
# Two vocabularies live here. Names the BOILERPLATE validates at boot (APP_*, DATABASE_*, AUTH_*,
# MAIL_*, FILE_*) must keep their spelling or the process refuses to start — see
# src/*/config/*.config.ts. Names under "Eatzify" are ours and are read by our own modules.

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development                  # development | staging | production
APP_PORT=3001
APP_NAME=Eatzify
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
FRONTEND_DOMAIN=http://localhost:3000
BACKEND_DOMAIN=http://localhost:3001
APP_CORS_ORIGINS=http://localhost:3000

# ── Database (docs/08) ────────────────────────────────────────────────────────
# Use localhost when running the API on the host; use "postgres" inside docker compose.
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=root
DATABASE_PASSWORD=secret
DATABASE_NAME=api
DATABASE_SYNCHRONIZE=false            # MUST stay false — docs/08, migrations are forward-only
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=
DATABASE_URL=
PGCRYPTO_KEY_ID=local-dev-key         # KMS key id for health-column encryption

# ── Redis / queues (docs/06 §6) ───────────────────────────────────────────────
WORKER_HOST=redis://localhost:6379/1  # boilerplate name, used by BullMQ
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=eatzify
JOB_CONCURRENCY=5

# ── Auth ──────────────────────────────────────────────────────────────────────
# Boilerplate names. Generate real values: openssl rand -hex 32
AUTH_JWT_SECRET=dev-only-change-me
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=dev-only-change-me-refresh
AUTH_REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_FORGOT_SECRET=dev-only-change-me-forgot
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=dev-only-change-me-confirm
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d
AUTH_UNIFORM_ERRORS=false
# Eatzify: phone OTP is primary auth in India (docs/09). Rate limits per docs/09 §10 — the cap
# matters, docs/18 §9 warns OTP SMS is the dominant cost and scales with signups, not revenue.
OTP_TTL_SECONDS=300
OTP_MAX_PER_HOUR=3
ADMIN_TOTP_ISSUER=Eatzify

# ── Mail (dev: maildev on 1025) ───────────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@eatzify.app
MAIL_DEFAULT_NAME=Eatzify
MAIL_CLIENT_PORT=1080

# ── Storage — Cloudflare R2 (S3-compatible, D-22) ─────────────────────────────
# R2 has no egress fee, which is the storage cost that scales with users. The AWS SDK talks to it
# unchanged — only the endpoint differs. Create a bucket + token at dash.cloudflare.com > R2.
FILE_DRIVER=local                     # local | s3 | s3-presigned. Use s3-presigned in prod.
S3_ENDPOINT=                          # https://<account_id>.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=true              # R2 requires path-style addressing
AWS_S3_REGION=auto                    # R2 ignores region; 'auto' is the documented value
AWS_DEFAULT_S3_BUCKET=eatzify-dev
ACCESS_KEY_ID=                        # R2 Access Key ID
SECRET_ACCESS_KEY=                    # R2 Secret Access Key
SIGNED_URL_TTL_SECONDS=300
# Only if a public custom domain is attached. NEVER for progress photos — docs/13 §6.
R2_PUBLIC_BASE_URL=

# ── Eatzify: engine (docs/04) ─────────────────────────────────────────────────
RULE_PACK_VERSION=1.0.0
RULE_PACK_DIR=./config/rule-packs
ENGINE_STRICT_ASSERTIONS=true         # true in dev/staging: fail loudly on total mismatch
DEFAULT_TIMEZONE=Asia/Kolkata
DIARY_DAY_START_HOUR=4                # diary day boundary, IST (docs/03 §6)
LOG_LEVEL=debug
ALLOW_SEED_DATA=true                  # MUST be false in production

# ── Eatzify: payments (docs/11, docs/12) ──────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_PLAY_PACKAGE_NAME=app.eatzify
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=     # base64; never commit
PLAY_RTDN_TOPIC=
AFA_THRESHOLD_PAISE=1500000           # ₹15,000 — RBI E-mandate Framework 2026
GST_RATE_BPS=1800                     # 18%

# ── Eatzify: notifications ────────────────────────────────────────────────────
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_OTP=
MSG91_DLT_TEMPLATE_RENEWAL=

# ── Eatzify: food vision (D-238, D-239) ───────────────────────────────────────
# Which model looks at a meal photo. The named provider needs its key; without one (or with
# `none`) POST /foods/scan answers 503 SCAN_UNAVAILABLE. Who may scan is the admin's scan_policy.
FOOD_VISION_PROVIDER=                 # deepseek | anthropic | none
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# A confirmed scan keeps the user's photo privately (D-240): outside ./files, served only by a
# signed link, deleted after the retention window. Production: a private R2 bucket (D-22).
MEAL_PHOTO_DIR=files-private/meal-photos
MEAL_PHOTO_LINK_TTL_SECONDS=3600
MEAL_PHOTO_RETENTION_DAYS=90         # docs/13 §6

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ── Compliance (docs/13) ──────────────────────────────────────────────────────
CONSENT_NOTICE_VERSION=2026-08-01
RETENTION_JOB_ENABLED=true
ERASURE_NOTICE_HOURS=48               # DPDP Rules 2025 pre-erasure notice
GRIEVANCE_OFFICER_EMAIL=
DATA_RETENTION_YEARS_HEALTH=3

# Admin panel (AdminJS) session signing key. 32+ chars. The panel refuses to start without it.
ADMIN_SESSION_SECRET=change-me-to-a-32-plus-character-random-string

# ── Cashfree Payment Gateway (docs/11) ────────────────────────────────────────
# stub       takes no money and calls nobody; POST /billing/checkout/simulate stands in for the
#            webhook so the whole activation path is testable before credentials are issued.
#            Refused at boot when NODE_ENV=production.
# sandbox    Cashfree's test gateway. Needs real sandbox credentials from their dashboard.
# production the live gateway.
# docs/11 §6: one trial per phone number, checked against a hash. Salt it per deployment; never
# change it afterwards, or every number gets a second trial.
TRIAL_PEPPER=eatzify-trial

CASHFREE_MODE=stub

# Dummy values. The real ones come from the Cashfree dashboard and never enter this file or git.
#
# There is NO separate webhook secret to create. Cashfree signs webhooks with this same Client
# Secret, so CASHFREE_SECRET_KEY is both the API credential and the key that proves a payment
# notification is genuine. Boot refuses a sandbox or production build without a real one: without
# it every webhook is rejected, which means cards are charged and nothing is activated.
CASHFREE_APP_ID=TEST_APP_ID_REPLACE_ME
CASHFREE_SECRET_KEY=TEST_SECRET_REPLACE_ME

# Where the gateway sends the browser back after checkout. Optional.
CASHFREE_RETURN_URL=

# D-243: exercise animations are © Gym visual and need a licence. Empty = no media (the default).
# Once licensed, the base URL the GIFs/JPGs are served from, e.g. https://cdn.example.com/exercises
GYM_MEDIA_BASE_URL=
