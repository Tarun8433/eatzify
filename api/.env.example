# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development                  # development | staging | production
APP_NAME=Eatzify
APP_BASE_URL=http://localhost:3000
API_VERSION=v1
DEFAULT_TIMEZONE=Asia/Kolkata
DIARY_DAY_START_HOUR=4                # diary day boundary, IST (doc 03 §6)
LOG_LEVEL=debug
ALLOW_SEED_DATA=true                  # MUST be false in production

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://eatzify:changeme@localhost:5432/eatzify
DATABASE_SSL=false
DATABASE_MAX_POOL=20
PGCRYPTO_KEY_ID=local-dev-key         # KMS key id for health-column encryption

# ── Redis / queues ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=eatzify
JOB_CONCURRENCY=5

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300
OTP_MAX_PER_HOUR=3
ADMIN_TOTP_ISSUER=Eatzify

# ── Engine ────────────────────────────────────────────────────────────────────
RULE_PACK_VERSION=1.0.0
RULE_PACK_DIR=./config/rule-packs
ENGINE_STRICT_ASSERTIONS=true         # true in dev/staging: fail loudly on total mismatch

# ── Payments ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_PLAY_PACKAGE_NAME=app.eatzify
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=     # base64; never commit
PLAY_RTDN_TOPIC=
AFA_THRESHOLD_PAISE=1500000           # ₹15,000 — RBI E-mandate Framework 2026
GST_RATE_BPS=1800                     # 18%

# ── Notifications ─────────────────────────────────────────────────────────────
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_OTP=
MSG91_DLT_TEMPLATE_RENEWAL=

# ── Storage — Cloudflare R2 (S3-compatible) ───────────────────────────────────
# R2 is used instead of AWS S3: zero egress fees, which matters for an image-heavy
# app serving India. The AWS SDK talks to it unchanged — only the endpoint differs.
# Create a bucket + API token at dash.cloudflare.com > R2.
FILE_DRIVER=s3-presigned          # local | s3 | s3-presigned. Use s3-presigned in prod.
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=true          # R2 requires path-style addressing
AWS_S3_REGION=auto                # R2 ignores region; 'auto' is the documented value
AWS_DEFAULT_S3_BUCKET=eatzify-dev
ACCESS_KEY_ID=                    # R2 Access Key ID
SECRET_ACCESS_KEY=                # R2 Secret Access Key
SIGNED_URL_TTL_SECONDS=300
# Public read URL if you attach a custom domain to the bucket. Never serve health
# images from a public bucket — docs/13 §6. Progress photos stay presigned-only.
R2_PUBLIC_BASE_URL=

# ── Food vision (Phase 3 — leave blank) ───────────────────────────────────────
FOOD_VISION_PROVIDER=                 # passio | logmeal | none
FOOD_VISION_API_KEY=

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ── Compliance ────────────────────────────────────────────────────────────────
CONSENT_NOTICE_VERSION=2026-08-01
RETENTION_JOB_ENABLED=true
ERASURE_NOTICE_HOURS=48               # DPDP Rules 2025 pre-erasure notice
GRIEVANCE_OFFICER_EMAIL=
DATA_RETENTION_YEARS_HEALTH=3
